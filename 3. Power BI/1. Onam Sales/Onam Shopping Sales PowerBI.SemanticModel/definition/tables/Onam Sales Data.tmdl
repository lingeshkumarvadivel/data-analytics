		lineageTag: 752eac53-6a04-4a48-81eb-1cdb5590fb68

	measure AvgDiscountPercent = AVERAGE('Onam Sales Data'[discount_percent])
		lineageTag: 21665119-573b-4f83-a7e0-d05cba60431a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalSpend = ```
			SUM('Onam Sales Data'[Sale AMount])
			
			
