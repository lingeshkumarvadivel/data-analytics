table 'Onam Sales Data'
	lineageTag: ade595b3-41cc-423b-a6bc-04eb9fc4a796

	measure RowCount_Varchar = ```
			COUNTROWS(VALUES('Onam Sales Data'[order_id]))
			
			```
		formatString: 0
		lineageTag: f5234fdd-5b5b-497c-b691-081167857853

	measure AverageOrderValue = ```
			
			DIVIDE(
			    SUMX('Onam Sales Data','Onam Sales Data'[quantity] * 'Onam Sales Data'[unit_price] * (1 - 'Onam Sales Data'[discount_percent]/100)),
			    COUNTROWS('Onam Sales Data')
			)
			
			```
		lineageTag: 6c93a8a1-c9c5-4a4c-8c3f-8050d5b01021

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CancellationRate = ```
			
			DIVIDE(
			    COUNTROWS(FILTER('Onam Sales Data','Onam Sales Data'[order_status] = "Cancelled")),
			    COUNTROWS('Onam Sales Data'),
			    0
			) * 100
			
			```
		lineageTag: d1be0d2b-9f66-4f67-8379-25570da11681

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CancelledOrders = ```
			COUNTROWS(FILTER('Onam Sales Data','Onam Sales Data'[order_status] = "Cancelled"))
			
			```
		formatString: 0
		lineageTag: 2cee9d90-cf05-489c-856b-f92cfa31382f

	measure DeliveredOrders = COUNTROWS(FILTER('Onam Sales Data', 'Onam Sales Data'[order_status] = "Delivered"))
		formatString: 0
		lineageTag: 88ba9399-5f6b-43db-a3bc-bd1a910683ab

	measure ReturnedOrders = COUNTROWS(FILTER('Onam Sales Data','Onam Sales Data'[order_status] = "Returned"))
		formatString: 0
		lineageTag: faac438e-a8a8-4f42-9d40-ba907ad1c05d

	measure 'Order Count' =
			
			CALCULATE(
				COUNTA('Onam Sales Data'[order_id]),
				ALLSELECTED('Onam Sales Data'[order_id])
			)
		formatString: 0
		lineageTag: d1190850-e692-4685-a2d3-7a1a3fc94273

		extendedProperty MeasureTemplate =
