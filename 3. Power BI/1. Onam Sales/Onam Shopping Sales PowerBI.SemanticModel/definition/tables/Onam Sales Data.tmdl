		lineageTag: 40079053-d899-4a63-acfd-429724561a5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OrderFrequency = ```
			COUNTROWS('Onam Sales Data')
			
			
			```
		formatString: 0
		lineageTag: 858a0fc4-801b-4b66-beb7-e5c2f6373a59

	measure PreferredPaymentMode = ```
			
			VAR ModeTable =
			    ADDCOLUMNS (
			        SUMMARIZE ( 'Onam Sales Data','Onam Sales Data'[customer_id],'Onam Sales Data'[payment_mode] ),
			        "OrderCount", COUNTROWS ( FILTER ('Onam Sales Data','Onam Sales Data'[customer_id] = EARLIER('Onam Sales Data'[customer_id]) 
			                                           && 'Onam Sales Data'[payment_mode] = EARLIER('Onam Sales Data'[payment_mode]) ) )
			    )
			VAR TopMode =
			    TOPN ( 1, ModeTable, [OrderCount], DESC )
			RETURN
			    MAXX ( TopMode, 'Onam Sales Data'[payment_mode] )
			
			```
		lineageTag: b318ea33-41c9-4c08-91b9-48686cb0d244

